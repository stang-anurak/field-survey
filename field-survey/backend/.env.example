# ===== Backend (Render) — ใส่ค่าจริงใน Render Environment ไม่ commit ไฟล์ .env =====
NODE_ENV=production
PORT=3000
# Origin ของ Frontend (ไม่มี path) คั่นด้วยคอมมา เช่น https://USER.github.io
ALLOWED_ORIGINS=
# Service Account JSON ที่เข้ารหัส base64 (ดู docs/GOOGLE_SETUP.md)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
SPREADSHEET_ID=
DRIVE_FOLDER_ID=
# (ทางเลือก) OAuth สำหรับ Drive กรณีใช้ My Drive ส่วนตัว (Service Account ไม่มีโควตาพื้นที่)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# สุ่มยาว >= 32 ตัวอักษร ใช้สร้างรหัสแก้ไข (เปลี่ยนแล้วรหัสแก้ไขที่ replay ด้วย Idempotency-Key จะเปลี่ยนตาม)
EDIT_TOKEN_SECRET=
# sha256 hex ของ WebGIS token คั่นด้วยคอมมาได้หลายค่า (หมุนเวียน/เพิกถอน) สร้างด้วย npm run token:generate
WEBGIS_TOKEN_HASHES=
# Cloudflare Turnstile (secret key ฝั่ง Backend)
TURNSTILE_SECRET_KEY=
# ใช้ได้เฉพาะ NODE_ENV != production เพื่อทดสอบในเครื่อง
TURNSTILE_BYPASS=false
# แสดงชื่อผู้สำรวจบน WebGIS/Export หรือไม่
PUBLIC_SURVEYOR_NAME=false
